# ─────────────────────────────────────────────
# MAAIS Backend - Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Neon PostgreSQL
# Get from: https://console.neon.tech -> Connection Details
# For Render: Set DATABASE_URL and DIRECT_URL in Render dashboard
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/maais?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.neon.tech/maais?sslmode=require"

# Redis (Upstash or Redis Cloud)
# Get from: https://console.upstash.com or https://redis.com
REDIS_URL="rediss://default:password@redis-host:6379"

# JWT - Use strong random strings (32+ characters)
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=your-strong-access-secret-here
JWT_REFRESH_SECRET=your-strong-refresh-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Twilio (SMS) - Optional
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Email (Nodemailer)
# For Gmail: Use App Password (not regular password)
# Get from: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Storage (Supabase Storage or S3)
# Get from: https://supabase.com/dashboard/project/_/storage
STORAGE_BUCKET_URL=https://xxxx.supabase.co/storage/v1/object/public/maais
STORAGE_SECRET=your-storage-secret

# QR / Verification
QR_BASE_URL=https://verify.mandoshts.edu.gh

# CORS - Add your frontend domain
# For Vercel: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# Production Notes:
# 1. Set NODE_ENV=production on Render
# 2. Use DATABASE_URL from Neon (not localhost)
# 3. Generate strong JWT secrets (never use defaults)
# 4. Enable CORS for your Vercel frontend domain
# 5. Run `npx prisma migrate deploy` after deployment

